{
  "name": "zapixal",
  "version": "1.0.0",
  "description": "Zapixal - Free Private Image Converter & Compressor. 100% Client-Side.",
  "type": "module",
  "main": "public/zapixal-web-component.js",
  "keywords": [
    "image-converter",
    "image-compressor",
    "offline-converter",
    "heic-to-jpg",
    "privacy-first"
  ],
  "author": "Zapixal",
  "license": "MIT",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "tsx scripts/generate-sitemap.ts && vite build && tsx scripts/generate-sw-manifest.ts && vite build --ssr src/entry-server.tsx --outDir dist-ssr && tsx scripts/prerender.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "tsx scripts/test-codecs.ts && tsx scripts/test-orchestration.ts && tsx scripts/test-seo-quality.ts && tsx scripts/test-routing-presets.ts"
  },
  "dependencies": {
    "@jsquash/avif": "^2.1.1",
    "@jsquash/jpeg": "^1.6.0",
    "@jsquash/webp": "^1.5.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.1",
    "heic2any": "^0.0.4",
    "imagequant": "^0.1.2",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tailwind-merge": "^3.6.0",
    "upng-js": "^2.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/upng-js": "^2.1.5",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "serve-handler": "^6.1.7",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vite-plugin-wasm": "^3.6.0"
  }
}
